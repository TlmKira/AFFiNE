# Local fork image. Build this image from your fork before starting compose.
# Official ghcr.io/toeverything/affine images do not include your custom changes.
AFFINE_IMAGE=kite-affine:local

# set the port for the server container it will expose the server on
PORT=3010

# set the host for the server for outgoing links
# AFFINE_SERVER_HTTPS=true
# AFFINE_SERVER_HOST=affine.yourdomain.com
# or
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3010

# private key for signed tokens. Generate a long random value before production use.
AFFINE_PRIVATE_KEY=change-me-to-a-long-random-private-key

# position of the database data to persist
DB_DATA_LOCATION=~/.affine/self-host/postgres/pgdata
# position of the upload data(images, files, etc.) to persist
UPLOAD_LOCATION=~/.affine/self-host/storage
# position of the configuration files to persist
CONFIG_LOCATION=~/.affine/self-host/config
# position of the self-hosted notebook working directory
NOTEBOOK_WORKDIR_LOCATION=~/.affine/self-host/notebook

# database credentials
DB_USERNAME=affine
DB_PASSWORD=change-me-to-a-strong-database-password
DB_DATABASE=affine

# self-hosted Jupyter Notebook runtime
NOTEBOOK_IMAGE=kite-affine-notebook:local
NOTEBOOK_TOKEN=change-me-to-a-long-random-notebook-token
AFFINE_NOTEBOOK_ENABLED=true
AFFINE_NOTEBOOK_IDLE_TIMEOUT_SECONDS=900
AFFINE_NOTEBOOK_MAX_OUTPUT_BYTES=2000000
AFFINE_NOTEBOOK_MAX_CONCURRENT_KERNELS=4
NOTEBOOK_CPU_LIMIT=2
NOTEBOOK_MEMORY_LIMIT=2g

# Phone sign-in v1 uses mock verification codes.
# The code is always logged by the backend; keep API echo disabled in production.
AFFINE_PHONE_AUTH_ENABLED=true
AFFINE_PHONE_AUTH_MOCK_CODE_VISIBLE=false

# AI / Copilot is disabled until configured in config.json.
# Keep real API keys out of git.
# COPILOT_OPENAI_API_KEY=sk-your-key

# Optional SMTP for invitations, password reset, and email login.
# MAILER_HOST=smtp.example.com
# MAILER_PORT=465
# MAILER_USER=noreply@example.com
# MAILER_PASSWORD=change-me
# MAILER_SENDER=私有知识库服务 <noreply@example.com>
