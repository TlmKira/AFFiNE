# Local fork image. Build or pull this image from your fork before starting compose.
# Official ghcr.io/toeverything/affine images do not include your custom changes.
AFFINE_IMAGE=kite-affine:local

# Set the port exposed by the server container.
PORT=3010

# Set the public URL used for outgoing links.
# AFFINE_SERVER_HTTPS=true
# AFFINE_SERVER_HOST=affine.yourdomain.com
# or
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3010

# Private key for signed tokens.
# Recommended: leave this empty and create CONFIG_LOCATION/private.key with:
#   openssl ecparam -name prime256v1 -genkey -noout -out CONFIG_LOCATION/private.key
# Do not put a random string here. It must be a valid PEM private key if set.
AFFINE_PRIVATE_KEY=

# Persistent data locations. On Windows you can point these to F:/AFFiNEData/...
DB_DATA_LOCATION=~/.affine/self-host/postgres/pgdata
UPLOAD_LOCATION=~/.affine/self-host/storage
CONFIG_LOCATION=~/.affine/self-host/config
NOTEBOOK_WORKDIR_LOCATION=~/.affine/self-host/notebook

# Database credentials.
DB_USERNAME=affine
DB_PASSWORD=change-me-to-a-strong-database-password
DB_DATABASE=affine

# Self-hosted Jupyter Notebook runtime.
NOTEBOOK_IMAGE=kite-affine-notebook:local
NOTEBOOK_TOKEN=change-me-to-a-long-random-notebook-token
AFFINE_NOTEBOOK_ENABLED=true
AFFINE_NOTEBOOK_IDLE_TIMEOUT_SECONDS=900
AFFINE_NOTEBOOK_MAX_OUTPUT_BYTES=2000000
AFFINE_NOTEBOOK_MAX_CONCURRENT_KERNELS=4
NOTEBOOK_CPU_LIMIT=1.0
NOTEBOOK_MEMORY_LIMIT=2g

# Paper citation metadata lookup.
# Contact email is optional but recommended by open academic metadata APIs.
# Keep API keys empty unless you need higher quota.
# AFFINE_CITATION_CONTACT_EMAIL=you@example.com
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# Phone sign-in v1 uses mock verification codes.
# The code is always logged by the backend; keep API echo disabled in production.
AFFINE_PHONE_AUTH_ENABLED=true
AFFINE_PHONE_AUTH_MOCK_CODE_VISIBLE=false

# AI / Copilot calls external model APIs with your own keys.
# Enable the plugin here, then add provider keys in the admin Settings page
# or in CONFIG_LOCATION/config.json. Keep real API keys out of git.
AFFINE_COPILOT_ENABLED=false

# Optional SMTP for invitations, password reset, and email login.
# MAILER_HOST=smtp.example.com
# MAILER_PORT=465
# MAILER_USER=noreply@example.com
# MAILER_PASSWORD=change-me
# MAILER_SENDER=Private Knowledge Service <noreply@example.com>
